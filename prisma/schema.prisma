generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum PaymentStatus {
  PENDING
  PAID
  CANCELLED
  EXPIRED
  FAILED
}

enum ReadingStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum ReadingType {
  FULL
  PALACE
  DAI_VAN
  TIEU_VAN
  NGUYET_VAN
  NHAT_VAN
}

enum LedgerType {
  CREDIT
  DEBIT
  REFUND
  ADJUSTMENT
}

enum PseoEntityKind {
  MAIN_STAR
  PALACE
  SUPPORT_STAR
}

enum PseoPageKind {
  HUB
  ENTITY
  COMBINATION
}

enum PseoStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  name               String?
  passwordHash       String?
  avatarUrl          String?
  coinBalance        Int                 @default(0)
  role               Role                @default(USER)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  accounts           Account[]
  sessions           Session[]
  charts             Chart[]
  readings           Reading[]
  readingProgress    ReadingProgress[]
  ledgers            CoinLedger[]
  payments           PaymentOrder[]
  auditLogs          AuditLog[]
  assistantQuestions AssistantQuestion[]
  funnelEvents       FunnelEvent[]
  quanProfile        QuanProfile?
}

model Account {
  id                String    @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  expiresAt         DateTime?
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Chart {
  id                  String              @id @default(cuid())
  userId              String?
  title               String
  input               Json
  chart               Json
  isPrivate           Boolean             @default(true)
  creationIp          String?
  creationUserAgent   String?
  creationSource      String?
  creationAttribution Json?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  user                User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  readings            Reading[]
  assistantQuestions  AssistantQuestion[]
  funnelEvents        FunnelEvent[]
  aiDiscoveryResponse AiDiscoveryResponse?

  @@index([userId, createdAt])
  @@index([creationIp, createdAt])
  @@index([creationSource, createdAt])
}

model Reading {
  id                 String              @id @default(cuid())
  userId             String
  chartId            String
  type               ReadingType
  scopeKey           String
  status             ReadingStatus       @default(PENDING)
  priceCoins         Int
  content            String?
  promptMeta         Json?
  model              String?
  error              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  chart              Chart               @relation(fields: [chartId], references: [id], onDelete: Cascade)
  assistantQuestions AssistantQuestion[]
  progress           ReadingProgress[]

  @@unique([userId, chartId, type, scopeKey])
  @@index([userId, type, scopeKey, status, createdAt])
  @@index([chartId, type, scopeKey, status])
}

model ReadingProgress {
  id            String   @id @default(cuid())
  userId        String
  readingId     String
  chapterKey    String
  chapterIndex  Int
  percent       Int
  chapterOffset Float
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reading       Reading  @relation(fields: [readingId], references: [id], onDelete: Cascade)

  @@unique([userId, readingId])
  @@index([readingId])
}

model InterpretationRule {
  key            String   @id
  scope          String
  pattern        Json
  priority       Int
  title          String
  summary        String
  strengthText   String
  cautionText    String
  lifeAdviceText String
  teaserQuestion String
  evidenceLabel  String
  version        String
  status         String   @default("active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([scope, status, priority])
  @@index([version, status])
}

model AssistantQuestion {
  id        String   @id @default(cuid())
  userId    String
  chartId   String
  readingId String
  slot      Int
  question  String
  answer    String?
  model     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chart     Chart    @relation(fields: [chartId], references: [id], onDelete: Cascade)
  reading   Reading  @relation(fields: [readingId], references: [id], onDelete: Cascade)

  @@unique([userId, chartId, slot])
  @@index([userId, chartId, createdAt])
}

model CoinLedger {
  id          String     @id @default(cuid())
  userId      String
  type        LedgerType
  amount      Int
  balance     Int
  reason      String
  referenceId String?
  createdAt   DateTime   @default(now())
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CoinPackage {
  id         String         @id @default(cuid())
  key        String         @unique
  label      String
  coins      Int
  priceVnd   Int
  bonusCoins Int            @default(0)
  isActive   Boolean        @default(true)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  payments   PaymentOrder[]
}

model FeaturePrice {
  key        String   @id
  label      String
  priceCoins Int
  isActive   Boolean  @default(true)
  updatedAt  DateTime @updatedAt
}

model OperationSettings {
  id                  String   @id @default("global")
  paymentsEnabled     Boolean  @default(true)
  coinTopupEnabled    Boolean  @default(true)
  paidReadingsEnabled Boolean  @default(true)
  updatedAt           DateTime @updatedAt
}

model PaymentOrder {
  id            String        @id @default(cuid())
  userId        String
  packageId     String?
  orderCode     BigInt        @unique
  paymentLinkId String?       @unique
  amountVnd     Int
  coins         Int
  status        PaymentStatus @default(PENDING)
  checkoutUrl   String?
  rawPayload    Json?
  attribution   Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  paidAt        DateTime?
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  package       CoinPackage?  @relation(fields: [packageId], references: [id], onDelete: SetNull)
}

model PaymentReconciliationRun {
  id                String   @id @default(cuid())
  dryRun            Boolean  @default(false)
  olderThanHours    Int
  scanned           Int
  updated           Int
  unchanged         Int
  cancelled         Int
  expired           Int
  failed            Int
  paidObserved      Int
  mismatches        Int
  providerErrors    Int
  concurrentChanges Int
  startedAt         DateTime
  finishedAt        DateTime
  createdAt         DateTime @default(now())

  @@index([createdAt])
}

enum QuanOrderStatus {
  PENDING
  PAID
  QUEUED
  INVITED
  ACTIVE
  ENDED
  REFUND
  CANCELLED
}

model QuanOrder {
  id              String          @id @default(uuid())
  ownerId         String
  alias           String
  recoveryDigest  String          @unique
  orderCode       BigInt          @unique
  paymentLinkId   String?         @unique
  checkoutUrl     String?
  qrCode          String?
  amountVnd       Int
  minutes         Int
  chart           Json
  readingKind     String          @default("tuvi")
  status          QuanOrderStatus @default(PENDING)
  expiresAt       DateTime
  checkedAt       DateTime?
  paidAt          DateTime?
  queuedAt        DateTime?
  inviteExpiresAt DateTime?
  tableNumber     Int?
  startedAt       DateTime?
  endsAt          DateTime?
  outageSince     DateTime?
  refundAmountVnd Int?
  refundSettledAt DateTime?
  createdAt       DateTime        @default(now())
  turns           QuanTurn[]
  encounter       QuanEncounter?

  @@index([ownerId, createdAt])
  @@index([status, queuedAt])
}

model QuanTurn {
  orderId    String
  id         String
  question   String
  answer     String?
  state      String
  attempt    Int      @default(1)
  startedAt  DateTime
  deadlineAt DateTime
  createdAt  DateTime @default(now())
  order      QuanOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@id([orderId, id])
  @@index([orderId, state])
}

model QuanSettings {
  id        String @id
  maxTables Int    @default(3)
}

model QuanProfile {
  id             String   @id @default(uuid())
  userId         String?  @unique
  alias          String
  birthInput     Json?
  equipped       Json     @default("{}")
  recoveryDigest String?  @unique
  blocked        Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  identities     QuanIdentity[]
  entries        QuanEntry[]
  items          QuanItem[]
  wishes         QuanWish[]
  reactions      QuanWishReaction[]
  reports        QuanWishReport[]
  shares         QuanShare[]
  metrics        QuanMetric[]
  encounters     QuanEncounter[]
}

model QuanEncounter {
  id              String      @id @default(uuid())
  profileId       String
  kind            String
  tier            String      @default("free")
  freeDay         String?
  orderId         String?     @unique
  state           String      @default("waiting")
  context         Json
  queuedAt        DateTime?
  inviteExpiresAt DateTime?
  startedAt       DateTime?
  endsAt          DateTime?
  outageSince     DateTime?
  speakingUntil   DateTime?
  createdAt       DateTime    @default(now())
  profile         QuanProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  order           QuanOrder?  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  turns           QuanEncounterTurn[]
  @@unique([profileId, freeDay])
  @@index([state, queuedAt])
}

model QuanEncounterTurn {
  encounterId String
  id          String
  kind        String
  question    String
  answer      String?
  state       String    @default("pending")
  interrupted Boolean   @default(false)
  attempt     Int       @default(1)
  deadlineAt  DateTime
  createdAt   DateTime  @default(now())
  encounter   QuanEncounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  @@id([encounterId, id])
  @@index([encounterId, createdAt])
}

model QuanIdentity {
  guestId   String      @id
  profileId String
  profile   QuanProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  @@index([profileId])
}

model QuanEntry {
  id        String      @id @default(uuid())
  profileId String
  kind      String
  dayKey    String
  points    Int         @default(0)
  data      Json
  version   String
  createdAt DateTime    @default(now())
  profile   QuanProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  @@unique([profileId, kind, dayKey])
  @@index([profileId, createdAt])
}

model QuanItem {
  profileId  String
  itemId     String
  acquiredAt DateTime    @default(now())
  profile    QuanProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  @@id([profileId, itemId])
}

model QuanWish {
  id        String      @id @default(uuid())
  profileId String
  text      String
  placement String
  status    String      @default("private")
  expiresAt DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  profile   QuanProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  reactions QuanWishReaction[]
  reports   QuanWishReport[]
  @@index([status, expiresAt, createdAt])
  @@index([profileId, createdAt])
}

model QuanWishReaction {
  wishId    String
  profileId String
  kind      String
  wish      QuanWish    @relation(fields: [wishId], references: [id], onDelete: Cascade)
  profile   QuanProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  @@id([wishId, profileId, kind])
}

model QuanWishReport {
  wishId    String
  profileId String
  userId    String?
  createdAt DateTime    @default(now())
  wish      QuanWish    @relation(fields: [wishId], references: [id], onDelete: Cascade)
  profile   QuanProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  @@id([wishId, profileId])
  @@unique([wishId, userId])
}

model QuanEvent {
  id         String   @id @default(uuid())
  title      String
  startsAt   DateTime
  endsAt     DateTime
  cancelled  Boolean  @default(false)
  @@index([startsAt, endsAt])
}

model QuanShare {
  id        String      @id
  profileId String
  snapshot  Json
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime    @default(now())
  profile   QuanProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  @@index([profileId, createdAt])
}

model QuanMetric {
  id         String      @id @default(uuid())
  profileId  String
  name       String
  dayKey     String
  source     String      @default("direct")
  linked     Boolean     @default(false)
  createdAt  DateTime    @default(now())
  profile    QuanProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  @@unique([profileId, name, dayKey])
  @@index([name, dayKey])
}

model QuanEcosystemSettings {
  id            String  @id
  publicPosting Boolean @default(true)
  features      Json    @default("{}")
}

model RateLimitBucket {
  keyHash     String
  windowStart DateTime
  count       Int      @default(1)
  expiresAt   DateTime
  updatedAt   DateTime @updatedAt

  @@id([keyHash, windowStart])
  @@index([expiresAt])
}

model FunnelEvent {
  id                 String   @id @default(cuid())
  name               String
  anonymousSessionId String?
  userId             String?
  chartId            String?
  source             String   @default("unknown")
  landingClass       String   @default("other")
  tool               String   @default("other")
  placement          String?
  resultBand         String?
  dedupeKey          String?  @unique
  createdAt          DateTime @default(now())
  user               User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  chart              Chart?   @relation(fields: [chartId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([name, createdAt])
  @@index([source, createdAt])
  @@index([tool, createdAt])
  @@index([userId, createdAt])
  @@index([chartId, createdAt])
}

model AiDiscoveryResponse {
  id         String   @id @default(cuid())
  chartId    String   @unique
  source     String
  aiPlatform String?
  prompt     String?  @db.VarChar(500)
  createdAt  DateTime @default(now())
  chart      Chart    @relation(fields: [chartId], references: [id], onDelete: Cascade)

  @@index([source, createdAt])
  @@index([aiPlatform, createdAt])
}

model ArticleCategory {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  articles    Article[]
}

model Article {
  id              String           @id @default(cuid())
  categoryId      String?
  title           String
  slug            String           @unique
  excerpt         String
  content         String
  status          String           @default("draft")
  coverImage      String?
  coverAlt        String?
  focusKeyword    String?
  metaTitle       String?
  metaDescription String?
  canonicalUrl    String?
  robots          String           @default("index,follow")
  ogImage         String?
  ogTitle         String?
  ogDescription   String?
  schemaType      String           @default("Article")
  faqs            Json?
  seoScore        Int              @default(0)
  seoChecklist    Json?
  publishedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  category        ArticleCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
}

model PseoEntity {
  id            String         @id @default(cuid())
  kind          PseoEntityKind
  slug          String         @unique
  name          String
  element       String?
  summary       String
  strengths     Json?
  cautions      Json?
  canonicalPath String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  pagesAsStar   PseoPage[]     @relation("PseoStar")
  pagesAsPalace PseoPage[]     @relation("PseoPalace")

  @@index([kind, name])
}

model PseoPage {
  id              String       @id @default(cuid())
  kind            PseoPageKind
  status          PseoStatus   @default(DRAFT)
  slug            String       @unique
  title           String
  excerpt         String
  body            String
  starId          String?
  palaceId        String?
  element         String?
  goodPoints      Json?
  cautionPoints   Json?
  scores          Json?
  faqs            Json?
  focusKeyword    String?
  metaTitle       String?
  metaDescription String?
  canonicalUrl    String?
  robots          String       @default("noindex,follow")
  auditScore      Int          @default(0)
  auditFindings   Json?
  generationMeta  Json?
  publishedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  star            PseoEntity?  @relation("PseoStar", fields: [starId], references: [id], onDelete: SetNull)
  palace          PseoEntity?  @relation("PseoPalace", fields: [palaceId], references: [id], onDelete: SetNull)

  @@unique([starId, palaceId])
  @@index([status, kind, updatedAt])
  @@index([starId, status])
  @@index([palaceId, status])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}
